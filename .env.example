# ==========================================
# Application Configuration
# ==========================================
PORT=8000
NODE_ENV=development

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# ==========================================
# Database Configuration
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_NAME=nest_template

# ==========================================
# JWT Authentication
# Generate secure secrets using:
#   openssl rand -base64 32
#   or
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ==========================================
JWT_ACCESS_SECRET=your_super_secure_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=different_secure_refresh_secret_min_32_chars_long
JWT_EXPIRES_IN=15m

# ==========================================
# Rate Limiting (Throttling)
# TTL in seconds, limit is max requests per TTL
# ==========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=10
